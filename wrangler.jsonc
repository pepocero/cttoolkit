{
  "name": "ct-toolkit-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct-toolkit",
      "database_id": "19cc0ce0-edd3-4e9e-9c4b-3db83332ff35",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SEED_USER_EMAIL": "pepocero@gmail.com",
    "ALLOW_REGISTRATION": "true",
    "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://ct-toolkit.pages.dev,https://toolkit.carlinitools.com"
  }
}
